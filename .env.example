# Apollo GraphQL origin (no trailing slash). Client calls `${url}/graphql`.
# Staging/local examples:
#   NEXT_PUBLIC_GRAPHQL_URL=https://api.slashie.app
#   NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=https://api.slashie.app

# Google Identity Services client ID (same Google Cloud OAuth client as SlashieApp/web
# is fine — add this admin origin under Authorized JavaScript origins).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required for `bun run codegen` (live SDL at `${NEXT_PUBLIC_GRAPHQL_URL}/schema`).
SCHEMA_ACCESS_TOKEN=

# PostHog product analytics (server-only). Never prefix the personal key with NEXT_PUBLIC_.
# Used by /dashboard and Analytics sections on user/task detail.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional. Defaults to https://eu.posthog.com
POSTHOG_HOST=https://eu.posthog.com
