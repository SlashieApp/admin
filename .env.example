# Apollo GraphQL origin (no trailing slash). Client calls `${url}/graphql`.
# Staging/local examples:
#   NEXT_PUBLIC_GRAPHQL_URL=https://api.slashie.app
#   NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=https://api.slashie.app

# Google Identity Services client ID (same Google Cloud OAuth client as SlashieApp/web
# is fine — add this admin origin under Authorized JavaScript origins).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Used only if you switch codegen.ts to the remote SDL instead of schema/admin.graphql.
SCHEMA_ACCESS_TOKEN=
